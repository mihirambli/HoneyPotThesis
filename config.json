{
  "post_body_inspection": false,
  "sql_injection": {
    "enabled": 1,
    "paths": ["/api/login"],
    "methods": ["POST"],
    "watch_fields": ["username", "password"],
    "reflect_max_len": 200,
    "signatures": [
      "' or ",
      "' and ",
      "' or '",
      ") or (",
      "or 1=1",
      "or 1 = 1",
      "'--",
      "' --",
      "'#",
      "' #",
      "admin'",
      "' union",
      "union select",
      "union all select",
      "; drop ",
      "drop table",
      "information_schema",
      "sleep(",
      "benchmark(",
      "waitfor delay",
      "xp_cmdshell",
      "/*"
    ],
    "status_code": 500,
    "error_template": "<!DOCTYPE html><html><head><title>Database Error</title></head><body><h1>Database Error</h1><p><b>Warning</b>: mysqli_query(): (42000/1064): You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '{PAYLOAD}' at line 1 in <b>/var/www/html/inc/db.php</b> on line <b>118</b></p><pre>SELECT id, username, email, role FROM users WHERE username = '{PAYLOAD}' AND password = MD5(?) LIMIT 1</pre><hr><address>Apache/2.4.41 (Ubuntu) Server at localhost Port 80</address></body></html>",
    "deny_status_code": 401,
    "deny_template": "<!DOCTYPE html><html><head><title>Sign in</title></head><body><h1>Sign in failed</h1><p>Invalid username or password.</p><p><a href=/login.html>Back to login</a></p></body></html>"
  },
  "honeytokens": {
    "html_comments": [
      {
        "enabled": 1,
        "paths": ["/*"],
        "comment_value": "<!-- DEV-PORTAL: internal-admin.example.com -->",
        "trigger_keyword": "internal-admin.example.com"
      },
      {
        "enabled": 1,
        "paths": ["/index.html"],
        "comment_value": "<!-- TODO: remove debug endpoint /api/v1/debug?token=abc123 -->",
        "trigger_keyword": "abc123"
      },
      {
        "enabled": 1,
        "paths": ["/dashboard.html"],
        "comment_value": "<!-- staging API: https://staging-api.example.com key=sk_live_9f8e7d6c -->",
        "trigger_keyword": "sk_live_9f8e7d6c"
      }
    ],
    "http_headers": [
      {
        "enabled": 1,
        "paths": ["/*"],
        "header_name": "X-Backend-Server",
        "header_value": "app-07.internal.example.com",
        "trigger_keyword": "app-07.internal.example.com"
      }
    ],
    "cookies": [
      {
        "enabled": 1,
        "paths": ["/*"],
        "cookie_name": "admin_ui",
        "cookie_value": "0",
        "attributes": "Path=/; SameSite=Lax",
        "trigger_keyword": ""
      }
    ],
    "decoy_paths": [
      {
        "enabled": 1,
        "trap_path": "/api/v1/debug",
        "match_type": "prefix",
        "advertise_via": "link",
        "advertise_on_paths": ["/*"],
        "link_text": "debug console"
      }
    ],
    "form_fields": [
      {
        "enabled": 1,
        "paths": ["/login.html", "/admin.html"],
        "field_name": "is_admin",
        "field_value": "0",
        "trigger_keyword": ""
      }
    ]
  }
}
