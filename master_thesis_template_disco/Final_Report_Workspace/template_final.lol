\contentsline {lstlisting}{\numberline {4.1}An HTML-comment honeytoken. \texttt {comment\_value} is injected before \texttt {</body>} on every page; \texttt {trigger\_keyword} is searched for in the query string.}{19}{lstlisting*.46}%
\contentsline {lstlisting}{\numberline {4.2}An HTTP-header honeytoken. The header is set on every response; its value is the trigger keyword.}{19}{lstlisting*.53}%
\contentsline {lstlisting}{\numberline {4.3}A cookie honeytoken. HDM sets \texttt {admin\_ui=0} with the given attributes and raises an alert when the cookie comes back with another value.}{20}{lstlisting*.61}%
\contentsline {lstlisting}{\numberline {4.4}A decoy-path honeytoken. A hidden link to \texttt {trap\_path} is injected on every page; with \texttt {match\_type} \texttt {prefix}, a request for any path below it also raises an alert.}{20}{lstlisting*.70}%
\contentsline {lstlisting}{\numberline {4.5}A form-field honeytoken. The hidden field \texttt {is\_admin=0} is injected before \texttt {</form>} on the two pages with a form; submitting it with another value raises an alert.}{20}{lstlisting*.79}%
